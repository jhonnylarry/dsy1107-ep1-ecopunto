# Copiar a .env y completar. .env no se versiona.

# PostgreSQL
POSTGRES_USER=ecopunto
POSTGRES_PASSWORD=cambiar-en-produccion

# RabbitMQ (ambos nodos del clúster deben compartir la cookie)
RABBITMQ_USER=ecopunto
RABBITMQ_PASSWORD=cambiar-en-produccion
RABBITMQ_COOKIE=cambiar-por-un-valor-largo-y-aleatorio

# Microsoft Entra ID (App Registration)
JWT_ISSUER=https://login.microsoftonline.com/<tenantId>/v2.0
JWT_JWKS_URI=https://login.microsoftonline.com/<tenantId>/discovery/v2.0/keys
JWT_AUDIENCE=<clientId>

# Origen del frontend (CORS)
ALLOWED_ORIGINS=https://<dominio-frontend>
